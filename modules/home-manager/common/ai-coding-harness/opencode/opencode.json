{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "plugins": [
    "opencode-antigravity-auth@2.1.2",
    "github:itsyasirkhandev/opencode-cline-free"
  ],
  "default_agent": "build",
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "background_compaction": true
  },
  "agents": {
    "build": {
      "mode": "primary",
      "permissions": [
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "critic-*", "effect": "allow" },
        { "action": "subagent", "resource": "worker-*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "sudo *", "effect": "ask" },
        { "action": "shell", "resource": "rm -rf*", "effect": "deny" },
        { "action": "shell", "resource": "rm -fr*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "rm -rf /tmp/opencode*",
          "effect": "allow"
        },
        {
          "action": "shell",
          "resource": "rm -fr /tmp/opencode*",
          "effect": "allow"
        },
        { "action": "shell", "resource": "git push*", "effect": "deny" },
        {
          "action": "shell",
          "resource": "git reset --hard*",
          "effect": "deny"
        },
        { "action": "shell", "resource": "git clean*", "effect": "deny" }
      ]
    },
    "reviewer": {
      "description": "Read-only orchestrator for adversarial review of the current working tree",
      "mode": "primary",
      "system": "You orchestrate adversarial reviews. You never modify files. Inspect the diff, run safe validation, invoke the critic subagents with full context, verify their findings, and report only confirmed issues with severity and file/line references.",
